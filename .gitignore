# Dependencies
node_modules
node_modules.nosync
/.pnp
.pnp.*
.yarn/*

# Next.js build output
.next
.next.nosync
/out
/build
*.tsbuildinfo
next-env.d.ts

# Environment variables (keep the example file)
.env
.env*
!.env.example

# Reference material in the project root: design images and content PDFs.
# Leading slashes limit these rules to the root, so images in public/ are still committed.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.pdf

# Logs and debug output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Vercel
.vercel

# Local Claude Code settings
.claude/settings.local.json

# OS and editor files
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.swp

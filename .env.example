# Public site URL used for canonical URLs, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.bizpedia.tech

# Contact form delivery (choose one). Without either, the form validates
# input but reports that delivery is not connected.
# 1) Forward enquiries as JSON to a webhook you control (Zapier, Make, n8n, a CRM, etc.)
CONTACT_WEBHOOK_URL=
# 2) Send enquiries by email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Local development only: set to "log" to print enquiries to the server console
# and show the success state without an external service.
CONTACT_DELIVERY=
